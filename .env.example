# Azure AI Foundry
AUTH_DISABLED=true
AZURE_AI_FOUNDRY_ENDPOINT=https://chenglongma-resource.services.ai.azure.com/api/projects/chenglongma
AZURE_AI_FOUNDRY_API_KEY=

# OpenAI models
OPENAI_ENDPOINT=https://chenglongma-resource.services.ai.azure.com/openai/v1
OPENAI_API_KEY=

REPLY_MODEL_NAME=gpt-5.5-2026-04-24
SEARCH_MODEL_NAME=gpt-5.5-2026-04-24
INTENT_CLASSIFIER_MODEL_NAME=gpt-5.4-mini
QUERY_REWRITER_MODEL_NAME=gpt-5.4-mini
AZURE_EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large

# Claude models
AZURE_CLAUDE_ENDPOINT=https://chenglongma-resource.services.ai.azure.com/anthropic/v1/messages
AZURE_CLAUDE_DEPLOYMENT_NAME=claude-opus-4-6-2

# Foundry Agent
RAG_AGENT_NAME=rag-answer-agent
RAG_AGENT_VERSION=6

# Internal Agents
REPLY_AGENT_PROMPT_VERSION=v1
SEARCH_AGENT_PROMPT_VERSION=v1
QUERY_REWRITER_PROMPT_VERSION=v1

# Microsoft Entra ID authentication
# Set to true only for local development or contract testing without bearer tokens.
AUTH_DISABLED=false
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=api://<backend-app-client-id>
ENTRA_REQUIRED_SCOPES=CourseBrain.Access
ENTRA_ALLOWED_CLIENT_IDS=

# Comma-separated frontend origins that may call this API from a browser.
CORS_ORIGINS=http://localhost:3000

# Azure Cosmos DB persistence
AZURE_COSMOS_ENDPOINT=https://on-course-db.documents.azure.com:443/
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE_NAME=on-course
AZURE_COSMOS_QA_MEMORY_CONTAINER=qa_memory
AZURE_COSMOS_REPLY_SESSIONS_CONTAINER=reply_sessions
AZURE_COSMOS_QNA_TOP_K=3
# Must match both the embedding deployment output and the container vector policy.
AZURE_COSMOS_EMBEDDING_DIMENSIONS=3072

# Search configs
PUBLIC_WEBSITE_URLS=https://www.rmit.edu.au/students/my-course/ai-in-learning/using-ai-assessments
WEB_SEARCH_TOP_K=3

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://course-brain-ai-search.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=rag-1781760741069
AZURE_SEARCH_VECTOR_FIELD=text_vector
AZURE_SEARCH_TEXT_FIELD=chunk
AZURE_SEARCH_SOURCE_FIELD=title
AZURE_SEARCH_KEYWORD_FIELDS=title,chunk
AZURE_SEARCH_TOP_K=5
AZURE_SEARCH_SEMANTIC_CONFIG_NAME=rag-1781760741069-semantic-configuration
