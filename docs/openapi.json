{
  "openapi": "3.1.0",
  "info": {
    "title": "OnCourse Agent API",
    "description": "Student reply sessions with lecturer review and revision workflows.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local development"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service health",
        "description": "Check that the application responds. This does not check upstream dependencies.",
        "operationId": "check_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "title": "Response Check Health"
                }
              }
            }
          }
        }
      }
    },
    "/reply-sessions": {
      "post": {
        "tags": [
          "Reply Sessions"
        ],
        "summary": "Create a reply session",
        "description": "Create a session in pending_generation state and return its conversation_id.",
        "operationId": "create_reply_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReplySessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplySession"
                }
              }
            }
          },
          "503": {
            "description": "The session could not be created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reply-sessions/{conversation_id}": {
      "get": {
        "tags": [
          "Reply Sessions"
        ],
        "summary": "Get a reply session",
        "description": "Return the current session state, student question, feedback, and generated revisions.",
        "operationId": "get_reply_session",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplySession"
                }
              }
            }
          },
          "404": {
            "description": "Reply session not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reply-sessions/{conversation_id}/generate": {
      "post": {
        "tags": [
          "Reply Sessions"
        ],
        "summary": "Generate or revise a session reply",
        "description": "Generate the first draft for a pending_generation session, or revise a draft for a revision_requested session using teacher feedback and existing evidence. The updated session enters awaiting_review. No request body is required.",
        "operationId": "generate_session_reply",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplySession"
                }
              }
            }
          },
          "404": {
            "description": "Reply session not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The session is not ready for generation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The reply could not be generated or checked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reply-sessions/{conversation_id}/review": {
      "post": {
        "tags": [
          "Reply Sessions"
        ],
        "summary": "Request a reply revision",
        "description": "Record teacher feedback for an awaiting_review session and move it to revision_requested. Call the generate operation to produce the revised draft.",
        "operationId": "review_reply_session",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewReplySessionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplySession"
                }
              }
            }
          },
          "404": {
            "description": "Reply session not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The session is not awaiting review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reply-sessions/{conversation_id}/accept": {
      "post": {
        "tags": [
          "Reply Sessions"
        ],
        "summary": "Accept a session reply",
        "description": "Persist the final draft from an awaiting_review session as historical Q&A, then mark the session accepted. No request body is required.",
        "operationId": "accept_reply_session",
        "parameters": [
          {
            "name": "conversation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Conversation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReplySession"
                }
              }
            }
          },
          "404": {
            "description": "Reply session not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The session is not awaiting review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "The accepted reply could not be persisted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateReplySessionRequest": {
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "course_id": {
            "type": "string",
            "minLength": 1,
            "title": "Course Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question",
          "course_id"
        ],
        "title": "CreateReplySessionRequest"
      },
      "HTTPErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "HTTPErrorResponse",
        "description": "Error body returned by HTTPException for reply-session operations."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReplySession": {
        "properties": {
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "course_id": {
            "type": "string",
            "minLength": 1,
            "title": "Course Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "student_query": {
            "type": "string",
            "minLength": 1,
            "title": "Student Query"
          },
          "status": {
            "$ref": "#/components/schemas/SessionStatus",
            "default": "pending_generation"
          },
          "revisions": {
            "items": {
              "$ref": "#/components/schemas/Revision"
            },
            "type": "array",
            "title": "Revisions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "conversation_id",
          "course_id",
          "student_query"
        ],
        "title": "ReplySession"
      },
      "ReviewReplySessionRequest": {
        "properties": {
          "feedback": {
            "type": "string",
            "minLength": 1,
            "title": "Feedback"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feedback"
        ],
        "title": "ReviewReplySessionRequest"
      },
      "Revision": {
        "properties": {
          "revision_number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision Number"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          },
          "revision_content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision_number"
        ],
        "title": "Revision"
      },
      "SessionStatus": {
        "type": "string",
        "enum": [
          "pending_generation",
          "awaiting_review",
          "revision_requested",
          "accepted"
        ],
        "title": "SessionStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Service availability."
    },
    {
      "name": "Reply Sessions",
      "description": "Create, generate, review, and accept lecturer reply drafts."
    }
  ]
}
